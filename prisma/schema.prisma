// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// GUIDESOFT TRAINING - COMPLETE DATABASE SCHEMA
// ============================================

// User Management
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?   // Null for OAuth users
  fullName      String
  avatarUrl     String?
  emailVerified Boolean   @default(false)
  verificationToken String?
  resetPasswordToken String?
  resetPasswordExpiry DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  isActive      Boolean   @default(true)
  
  // Relations
  profile           UserProfile?
  subscriptions     Subscription[]
  progress          UserProgress[]
  quizResults       QuizResult[]
  certificates      Certificate[]
  mentorshipSessions MentorshipSession[]
  payments          Payment[]
  aiLogs            AIGenerationLog[]
  bookmarks         Bookmark[]
  reviews           CourseReview[]
  
  @@index([email])
  @@index([isActive])
}

model UserProfile {
  userId            String  @id
  currentLevel      String  // beginner, intermediate, advanced, expert, master
  targetRole        String?
  timeCommitment    Int?    // hours per week
  learningStyle     String? // visual, hands-on, theoretical
  experience        Json?   // JSON object with skill details
  timezone          String  @default("UTC")
  language          String  @default("en")
  bio               String?
  linkedinUrl       String?
  githubUrl         String?
  twitterUrl        String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([currentLevel])
}

// Subscription & Payments
model Subscription {
  id                    String   @id @default(uuid())
  userId                String
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  tier                  String   // starter, professional, enterprise, lifetime
  status                String   @default("active") // active, canceled, past_due, unpaid, paused
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean  @default(false)
  canceledAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([stripeSubscriptionId])
}

model Payment {
  id                      String   @id @default(uuid())
  userId                  String
  amount                  Int      // in cents
  currency                String   @default("USD")
  stripePaymentIntentId   String?
  stripeInvoiceId         String?
  status                  String   // succeeded, pending, failed, refunded
  description             String?
  metadata                Json?
  createdAt               DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Course Management
model Course {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  description     String
  shortDescription String?
  tier            String   // foundation, intermediate, advanced, expert, master
  category        String   // ai_ml, web_dev, cloud, cybersecurity, ux_ui, devops, data_science, mobile, blockchain, quantum
  durationWeeks   Int
  difficultyLevel String   // beginner, intermediate, advanced, expert, master
  thumbnailUrl    String?
  videoPreviewUrl String?
  isPublished     Boolean  @default(false)
  isAiGenerated   Boolean  @default(false)
  price           Int?     // null if included in subscription
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  enrollmentCount Int      @default(0)
  prerequisites   Json?    // Array of required skills/courses
  learningOutcomes Json?   // Array of outcomes
  tags            String[] // Array of tags
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?
  
  // Relations
  modules     CourseModule[]
  enrollments UserProgress[]
  reviews     CourseReview[]
  
  @@index([slug])
  @@index([category])
  @@index([tier])
  @@index([isPublished])
  @@index([tags])
}

model CourseModule {
  id            String   @id @default(uuid())
  courseId      String
  title         String
  description   String?
  orderIndex    Int
  estimatedHours Int
  createdAt     DateTime @default(now())
  
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  
  @@index([courseId])
  @@index([orderIndex])
}

model Lesson {
  id              String   @id @default(uuid())
  moduleId        String
  title           String
  contentType     String   // video, text, interactive, quiz, code_challenge
  contentJson     Json     // Lesson content structure
  orderIndex      Int
  durationMinutes Int?
  isFreePreview   Boolean  @default(false)
  videoUrl        String?
  transcript      String?
  resources       Json?    // Array of downloadable resources
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  UserProgress[]
  quizResults QuizResult[]
  
  @@index([moduleId])
  @@index([orderIndex])
}

// Learning Progress
model UserProgress {
  id              String   @id @default(uuid())
  userId          String
  courseId        String
  lessonId        String?
  status          String   @default("not_started") // not_started, in_progress, completed
  progressPercentage Int   @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  lastAccessedAt  DateTime?
  timeSpentMinutes Int    @default(0)
  notes           String?
  
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  
  @@unique([userId, lessonId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model QuizResult {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  score       Int      // 0-100
  passed      Boolean
  answersJson Json     // User's answers
  correctAnswersJson Json? // Correct answers for review
  timeSpentSeconds Int?
  completedAt DateTime @default(now())
  
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([lessonId])
  @@index([completedAt])
}

model Certificate {
  id                String   @id @default(uuid())
  userId            String
  courseId          String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  verificationHash  String   @unique
  pdfUrl            String?
  metadata          Json?    // Grade, completion date, etc.
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([certificateNumber])
  @@index([verificationHash])
}

// AI & Personalization
model LearningPath {
  id                   String   @id @default(uuid())
  userId               String
  name                 String
  targetRole           String
  totalDurationWeeks   Int
  pathJson             Json     // Complete learning path structure
  isActive             Boolean  @default(true)
  completionPercentage Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isActive])
}

model AIGenerationLog {
  id          String   @id @default(uuid())
  userId      String?
  promptType  String   // curriculum, lesson, quiz, assessment, recommendation
  inputJson   Json
  outputJson  Json
  tokensUsed  Int
  costCents   Int
  model       String   @default("gemini-2.0-flash")
  createdAt   DateTime @default(now())
  
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([promptType])
  @@index([createdAt])
}

// Mentorship
model MentorshipSession {
  id            String   @id @default(uuid())
  userId        String
  mentorId      String
  scheduledAt   DateTime
  durationMinutes Int    @default(30)
  status        String   // scheduled, completed, canceled, rescheduled, no_show
  meetingLink   String?
  notes         String?
  feedback      String?
  rating        Int?     // 1-5
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentor User @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([mentorId])
  @@index([scheduledAt])
  @@index([status])
}

// Community & Engagement
model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  note      String?
  createdAt DateTime @default(now())
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@unique([userId, lessonId])
  @@index([userId])
}

model CourseReview {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  rating    Int      // 1-5
  title     String?
  comment   String?
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([userId, courseId])
  @@index([courseId])
  @@index([rating])
}

// Analytics & Tracking
model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   // page_view, course_enroll, lesson_complete, quiz_taken, payment_made
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
